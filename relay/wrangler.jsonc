{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tidings-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "Relay" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }],
  // OWNER_KEY, the Minecraft server allowed to connect, is a secret rather than a var: deploying
  // resets vars to what's here, and keeps secrets. Set it with `npx wrangler secret put OWNER_KEY`
  // or in the dashboard; for `wrangler dev`, in .dev.vars.
}
